# Copy to .env (or set in the Render dashboard). Every variable is optional.
PORT=5000
INDRA_ENGINE=1                 # 0 = API/UI only, no background feeds (used by tests)
INDRA_LIGHTNING=1              # Blitzortung community lightning websocket
INDRA_RADAR_INTERVAL=300       # seconds between NASA GIBS IMERG precipitation polls
INDRA_PRECIP_LIVE_AGE_S=5400   # IMERG frames older than this are DELAYED (no ETA / no INDRA alert)
# GIBS_PRECIP_LAYER=IMERG_Precipitation_Rate_30min
# GIBS_IR_LAYER=Himawari_AHI_Band13_Clean_Infrared
# GIBS_WMS_4326=https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi
INDRA_SACHET_INTERVAL=180      # seconds between NDMA SACHET official-alert polls
# SACHET_ALERTS_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails
INDRA_SATELLITE_INTERVAL=300   # seconds between EUMETSAT Meteosat IODC cycles
INDRA_MODEL_GRID_INTERVAL=3600 # seconds between national multi-model grid refreshes
INDRA_MODEL_GRID_DEG=1.0       # national model grid spacing (smaller = more Open-Meteo calls)
INDRA_RUNTIME_DIR=data/runtime # SQLite alert/audit/verification store
OPEN_METEO_API_KEY=            # optional commercial Open-Meteo key (raises rate limits)
IMD_API_TOKEN=                 # IMD API token; IMD also requires your server IP to be whitelisted
LOG_LEVEL=INFO

# Professional account access code (auto-generated and printed in the log if empty)
INDRA_PRO_ACCESS_CODE=
# Multiplier for auth rate limits (default 1)
INDRA_AUTH_RATE_MULT=1

# Email (verification + password reset). Without SMTP, emails go to the Admin console outbox.
INDRA_SMTP_HOST=
INDRA_SMTP_PORT=587
INDRA_SMTP_USER=
INDRA_SMTP_PASS=
INDRA_SMTP_FROM=
INDRA_SMTP_SSL=0               # 1 = implicit TLS on port 465
INDRA_PUBLIC_URL=              # e.g. https://indra.onrender.com (links in emails)
INDRA_REQUIRE_EMAIL_VERIFY=1
INDRA_EMAIL_DEMO_ECHO=0        # 1 = show codes on screen when no SMTP (demo only)
# Admin accounts (comma-separated). Empty = first professional registrant becomes admin.
INDRA_ADMIN_EMAILS=
# Built-in owner administrator (created on startup; protected from other admins)
INDRA_OWNER_EMAIL=
INDRA_OWNER_PASSWORD=          # empty = generate once, print in log, save to data/runtime/owner_credentials.txt
INDRA_OWNER_NAME=
